[Unit]
Description=MaM Portal (webmail login + mail proxy)
Documentation=https://github.com/afatyoo/MaM-Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mam
Group=mam
WorkingDirectory=/opt/mam-portal
Environment=NODE_ENV=production
Environment=DATA_DIR=/opt/mam-portal/data
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2

# Ports 993/995/465 are below 1024: grant the bind capability instead of running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The proxy only needs its own directory; config, certs and data live there.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/mam-portal/data
# TLS sessions and proxy connections are sockets, so this is not cosmetic.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
